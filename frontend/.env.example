# Base URL of the backend API (no trailing slash).
#
# Local development: copy this file to .env.local and use the local backend:
#   NEXT_PUBLIC_API_URL=http://localhost:5000
#
# Production: set this in the Vercel dashboard (Project → Settings →
# Environment Variables), e.g. the deployed Render backend:
NEXT_PUBLIC_API_URL=https://smart-todo-2o4n.onrender.com
